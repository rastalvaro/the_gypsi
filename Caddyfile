# Production web server for The Gypsi on Coolify (Dockerfile build pack).
# Serves the static Vite build in /srv. Caddy listens on :3000 (Coolify's default
# app port + healthcheck target); TLS is terminated upstream by Cloudflare. This
# file replaces the inert netlify.toml — the headers and routing below are what
# actually reach the browser.
#
# Key behaviours:
#  - Missing files return a real 404 (NO single-page-app fallback). The site has
#    no client-side router — every URL is a real file (/, /products/*.html, the
#    legal pages, /admin/) — so a missing /img/*.avif 404s instead of being served
#    index.html with a long cache header. That is what was poisoning the CDN with
#    text/html cached under image URLs. If a real client router is added later,
#    reintroduce a scoped SPA fallback for extensionless paths only.
#  - Security headers (CSP/HSTS/etc.) ported from the old netlify.toml.
#  - /admin (Sveltia CMS) gets its own, more permissive CSP.

:3000 {
	root * /srv
	encode zstd gzip

	# ---- /admin: Sveltia CMS (GitHub backend + unpkg bundle + auth worker) ----
	@admin path /admin /admin/*
	handle @admin {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "strict-origin-when-cross-origin"
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:; img-src 'self' data: blob: https:; connect-src 'self' https://api.github.com https://raw.githubusercontent.com https://unpkg.com https://sveltia-cms-auth.ingdimas.workers.dev; frame-src 'none'; object-src 'none'"
		}
		file_server
	}

	# ---- Everything else (the storefront + static product/legal pages) ----
	handle {
		header {
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
			# CSP allows our own bundle, inline styles/JSON-LD, self-hosted fonts,
			# and Snipcart (which needs 'unsafe-eval' for its new Function validators).
			# Add a newsletter form backend's domain to form-action when one is chosen.
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.snipcart.com; style-src 'self' 'unsafe-inline' https://fonts.bunny.net https://cdn.snipcart.com; font-src 'self' https://fonts.bunny.net https://cdn.snipcart.com; img-src 'self' data: https:; connect-src 'self' https://*.snipcart.com https://cdn.snipcart.com; frame-src https://*.snipcart.com; form-action 'self'; base-uri 'self'; object-src 'none'"
		}

		# Caching. Hashed build assets are immutable; photos/fonts are long-lived but
		# not content-hashed; fonts.css is the regenerable @font-face index (short).
		# Each matcher ALSO requires the file to exist (`file`) so a 404 never inherits
		# the long Cache-Control — otherwise a momentarily-missing asset (e.g. a new
		# upload whose variants haven't deployed yet) gets its 404 cached for a week.
		@assets {
			path /assets/*
			file
		}
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@img {
			path /img/*
			file
		}
		header @img Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
		@fonts {
			path /fonts/*
			not path /fonts/fonts.css
			file
		}
		header @fonts Cache-Control "public, max-age=31536000"
		@fontscss {
			path /fonts/fonts.css
			file
		}
		header @fontscss Cache-Control "public, max-age=3600, stale-while-revalidate=86400"

		file_server
	}
}
